          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "http_server_requests_seconds_max{application=\"$application\"}",
          "legendFormat": "Max Latency - {{method}} {{uri}} ({{status}})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "rate(http_server_requests_seconds_sum{application=\"$application\"}[1m]) / rate(http_server_requests_seconds_count{application=\"$application\"}[1m])",
          "legendFormat": "Avg Latency - {{method}} {{uri}} ({{status}})",
          "range": true,
          "refId": "B"
        }
      ]
    },
